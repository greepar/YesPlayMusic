{
  "name": "yesplaymusic",
  "version": "0.6.1",
  "private": true,
  "description": "A third party music player for Netease Music",
  "author": "qier222<qier222@outlook.com>",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "electron:build": "vue-cli-service electron:build -p never",
    "electron:build-all": "vue-cli-service electron:build -p never -mwl",
    "electron:build-mac": "vue-cli-service electron:build -p never -m",
    "electron:build-win": "vue-cli-service electron:build -p never -w",
    "electron:build-linux": "vue-cli-service electron:build -p never -l",
    "electron:serve": "vue-cli-service electron:serve",
    "electron:buildicon": "electron-icon-builder --input=./build/icons/icon.png --output=build --flatten",
    "electron:publish": "vue-cli-service electron:build -mwl -p always",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "prettier": "npx prettier --write ./src",
    "netease_api:run": "npx @neteasecloudmusicapienhanced/api"
  },
  "main": "index.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.40.1",
    "axios": "^1.20.0",
    "change-case": "^5.4.4",
    "cli-color": "^2.0.4",
    "color": "^5.0.3",
    "core-js": "^3.50.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "discord-rich-presence": "^0.0.8",
    "electron-context-menu": "^5.0.0",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-http-proxy": "^2.1.2",
    "extract-zip": "^2.0.1",
    "howler": "^2.2.4",
    "js-cookie": "^3.0.8",
    "jsbi": "^4.3.2",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "mpris-service": "^2.1.2",
    "music-metadata": "^11.15.0",
    "node-vibrant": "^4.0.4",
    "nprogress": "^0.2.0",
    "pac-proxy-agent": "^9.1.0",
    "plyr": "^3.8.4",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "register-service-worker": "^1.7.2",
    "svg-sprite-loader": "^6.0.11",
    "tunnel": "^0.0.6",
    "vscode-codicons": "^0.0.17",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vuex": "^4.1.0",
    "x11": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vue/cli-plugin-babel": "~5.0.9",
    "@vue/cli-plugin-eslint": "~5.0.9",
    "@vue/cli-plugin-pwa": "~5.0.9",
    "@vue/cli-plugin-vuex": "~5.0.9",
    "@vue/cli-service": "~5.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "babel-eslint": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "esbuild": "^0.28.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "husky": "^9.1.7",
    "node-loader": "^2.1.0",
    "prettier": "3.9.8",
    "sass": "^1.104.1",
    "sass-loader": "^17.0.1",
    "typescript": "~7.0.2",
    "vue-cli-plugin-electron-builder": "^3.0.0-alpha.4"
  },
  "resolutions": {
    "icon-gen": "3.0.0",
    "degenerator": "2.2.0",
    "electron-builder": "^26.15.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true
    },
    "extends": [
      "plugin:vue/essential",
      "plugin:vue/recommended",
      "plugin:prettier/recommended",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "globals": {
      "ipcRenderer": "off"
    },
    "rules": {},
    "ignorePatterns": [
      "*.ts",
      "*.d.ts"
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm run prettier"
    }
  }
}
